{
  "name": "agency-eventos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "start": "node --env-file=.env src/server.js",
    "test": "node --test --test-timeout=20000 tests/*.test.js",
    "check": "node --check src/server.js && node --check src/app.js && node --check public/app.js && npm test",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "html5-qrcode": "^2.3.8",
    "nodemailer": "^10.1.7",
    "qrcode": "^1.5.4"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0"
  }
}
